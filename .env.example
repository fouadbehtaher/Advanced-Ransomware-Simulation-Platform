# Advanced Ransomware Simulation Platform - Environment Configuration

# Simulation Environment
SIMULATION_MODE=isolated
SANDBOX_PATH=/tmp/arsp_sandbox
MAX_FILE_SIZE_MB=100
SIMULATION_TIMEOUT_SECONDS=300

# Security Settings
ENABLE_NETWORK_ISOLATION=true
ENABLE_FILESYSTEM_ISOLATION=true
ENABLE_PROCESS_MONITORING=true
ALLOWED_OPERATIONS=encrypt,decrypt,enumerate,exfiltrate

# Monitoring Configuration
LOG_LEVEL=INFO
LOG_PATH=./logs
ENABLE_DETAILED_LOGGING=true
ENABLE_METRICS_COLLECTION=true

# Analysis Configuration
ENABLE_BEHAVIORAL_ANALYSIS=true
ENABLE_STATIC_ANALYSIS=false
ANALYSIS_OUTPUT_PATH=./analysis_results

# Reporting
REPORT_FORMAT=json
ENABLE_AUTO_REPORT=true
REPORT_OUTPUT_PATH=./reports

# Database (Optional)
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/arsp.db

# API Configuration (Optional)
API_ENABLED=false
API_HOST=127.0.0.1
API_PORT=8000
API_KEY=your-secret-api-key-here
